{
  "name": "@ujjwalkumar93/petal-cli",
  "version": "0.0.1",
  "description": "CLI to scaffold and manage Petal apps",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ujjwalkumar93/petal.git",
    "directory": "packages/cli"
  },
  "bin": {
    "petal": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
