    "picocolors": "1.1.1",
    "prompts": "2.4.2"
  },
  "devDependencies": {
    "@petal/sdk": "workspace:*",
    "@petal/tsconfig": "workspace:*",
    "@types/prompts": "2.4.9",
    "esbuild": "0.28.2",
    "typescript": "5.9.3"
