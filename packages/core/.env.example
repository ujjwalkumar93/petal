# Frappe backend URL — used by the server-side proxy, never sent to the browser
FRAPPE_BACKEND_URL=http://localhost:8000

# Behind a reverse proxy (nginx, Caddy, a load balancer)? Trust its
# X-Forwarded-* headers. Leave unset when Petal is reached directly.
# PETAL_TRUST_PROXY=1

# Largest upload passed to Frappe (MB), and how long to wait for Frappe (ms).
# PETAL_MAX_BODY_MB=50
# PETAL_UPSTREAM_TIMEOUT_MS=120000

NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
