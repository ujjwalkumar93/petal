{
  "name": "petal",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @petal/core dev",
    "build": "pnpm --filter './packages/*' build",
    "lint": "eslint .",
    "typecheck": "pnpm --filter './packages/*' typecheck",
    "clean": "pnpm --filter '@petal/*' clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "ci": "pnpm typecheck && pnpm lint && pnpm test",
    "start": "pnpm --filter @petal/core build && pnpm --filter @petal/core start"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "^25.0.1",
    "typescript": "^5.4.5",
    "vitest": "^2.1.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
