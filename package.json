{
  "name": "petal",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "pnpm --filter @petal/core dev",
    "build": "pnpm --filter './packages/*' build",
    "lint": "eslint .",
    "typecheck": "pnpm --filter './packages/*' typecheck && tsc -p e2e",
    "clean": "pnpm --filter '@petal/*' clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "ci": "pnpm typecheck && pnpm lint && pnpm test",
    "start": "pnpm --filter @petal/core build && pnpm --filter @petal/core start"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "20.19.43",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "jsdom": "25.0.1",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "//overrides": "Replace only known-vulnerable transitive versions (pnpm audit). Remove an entry once its parent ships the fix.",
    "overrides": {
      "socket.io-parser@<4.2.7": "4.2.7",
      "nanoid@<3.3.18": "3.3.20",
      "postcss@<8.5.23": "8.5.32",
      "postcss-selector-parser@<6.1.5": "6.1.5",
      "browserslist@<4.28.7": "4.29.5",
      "source-map-js@<1.2.2": "1.2.2",
      "baseline-browser-mapping@<2.11.0": "2.11.33",
      "brace-expansion@>=1.0.0 <1.1.21": "1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "2.1.7"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
